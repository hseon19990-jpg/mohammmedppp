# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:AAF...

# Your Telegram User ID (from @userinfobot)
OWNER_TELEGRAM_ID=123456789

# Encryption key for stored credentials (use a strong random string)
ENCRYPTION_KEY=change_this_to_a_long_random_secret_string_at_least_32_chars

# (Optional) Directory to store encrypted data file
# DATA_DIR=/app/data
