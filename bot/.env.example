# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:AAF...

# Your Telegram User ID (from @userinfobot)
OWNER_TELEGRAM_ID=123456789

# Optional: chats that receive every new purchase notification.
# The bot must be a member/admin in both chats. Use @username or -100... IDs.
PURCHASE_CHANNEL_1=@your_first_group
PURCHASE_CHANNEL_2=@your_second_group

# (Optional) Directory to store persistent data
# DATA_DIR=/app/data
#
# Railway: attach a Volume to the service with mount path /app/data.
# Railway provides RAILWAY_VOLUME_MOUNT_PATH automatically when attached.
